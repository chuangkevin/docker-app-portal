{
  "name": "docker-app-portal",
  "version": "2.0.0",
  "private": true,
  "description": "服務入口：自動列出 homelab 所有機器上的網頁服務，有網域就用網域",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "better-sqlite3": "11.10.0",
    "fastify": "5.4.0",
    "@fastify/static": "8.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
